{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumperscripts",
  "compatibility_date": "2025-09-27",
  "main": "cloudflare/script-registry-worker/src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "cloudflare/script-registry-worker/scripts"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Pluggable Arduino compile backend used by POST /compile. Defaults to Wokwi's
  // build endpoint (same contract Wokwi's editor uses); point this at a
  // self-hosted compiler later without touching code.
  "vars": {
    "COMPILER_URL": "https://wokwi.com/build"
  },
  "kv_namespaces": [
    {
      "binding": "SCRIPTS",
      "id": "0836c3ab1d4e4d6d8fffbbb6219aca4e"
    }
  ]
}
